# =============================================================================
# AI Investment Arena — environment template
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# --- Demo / AI ---------------------------------------------------------------
DEMO_MODE=true
AI_PROVIDER=mock
# gemini | groq | mock
MAX_AI_RETRIES=2
MAX_AI_CALLS_PER_WORKFLOW=8

# --- Gemini / Groq (optional when DEMO_MODE=true or AI_PROVIDER=mock) --------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=

# --- Investor Due-Diligence Engine API Keys -----------------------------------
TAVILY_API_KEY=
SERPER_API_KEY=
MCA_API_KEY=
MCA_API_BASE_URL=https://api.enterprise-mca.in

# --- Supabase (hosted free tier — do not run locally by default) -------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side only — never expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Neo4j -------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fundx_neo4j_password
NEO4J_AUTH=neo4j/fundx_neo4j_password

# --- Internal service URLs (Docker network) ----------------------------------
USER_SERVICE_URL=http://user-service:8001
STARTUP_SERVICE_URL=http://startup-service:8002
INVESTOR_SERVICE_URL=http://investor-service:8003
DEAL_SERVICE_URL=http://deal-service:8004
AI_SERVICE_URL=http://ai-service:8005

# --- Database (PostgreSQL & Adminer UI at http://localhost:8080) -------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fundx_user
POSTGRES_PASSWORD=fundx_password
POSTGRES_DB=fundx_db
DATABASE_URL=postgresql://fundx_user:fundx_password@postgres:5432/fundx_db

# --- Frontend & App Admin Credentials ----------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_ADMIN_EMAIL=admin@fundx.ai
VITE_ADMIN_PASSWORD=admin123
# Never put SUPABASE_SERVICE_ROLE_KEY in VITE_* vars
