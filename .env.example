# =============================================================================
# AI Investment Arena — environment template
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# --- Demo / AI ---------------------------------------------------------------
# Keep DEMO_MODE=true for offline demos (MockProvider, no API keys needed).
DEMO_MODE=true
AI_PROVIDER=mock
# gemini | groq | mock
MOCK_RESEARCH=true
MAX_AI_RETRIES=2
MAX_AI_CALLS_PER_WORKFLOW=8

# Local file storage (CV / incorporation docs). Docker mounts ./uploads → /app/uploads
UPLOAD_ROOT=/app/uploads
MAX_UPLOAD_BYTES=5242880

# --- Gemini / Groq (only when DEMO_MODE=false) -------------------------------
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ADK / google-genai also accept GOOGLE_API_KEY (same value as GEMINI_API_KEY)
GOOGLE_API_KEY=
GROQ_API_KEY=

# Live AI example (still $0 on free tier — watch rate limits):
# DEMO_MODE=false
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_key_here
# GOOGLE_API_KEY=your_key_here
# MOCK_RESEARCH=true

# --- Postgres (Docker Compose) -----------------------------------------------
POSTGRES_USER=fundx_user
POSTGRES_PASSWORD=fundx_password
POSTGRES_DB=fundx_db
DATABASE_URL=postgresql://fundx_user:fundx_password@postgres:5432/fundx_db

# --- Supabase (optional hosted free tier — not required for local demo) ------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side only — never expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Neo4j -------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fundx_neo4j_password
NEO4J_AUTH=neo4j/fundx_neo4j_password

# --- Internal service URLs (Docker network) ----------------------------------
USER_SERVICE_URL=http://user-service:8001
STARTUP_SERVICE_URL=http://startup-service:8002
INVESTOR_SERVICE_URL=http://investor-service:8003
DEAL_SERVICE_URL=http://deal-service:8004
AI_SERVICE_URL=http://ai-service:8005

# --- Frontend ----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_ADMIN_EMAIL=admin@fundx.ai
VITE_ADMIN_PASSWORD=admin123
# Never put SUPABASE_SERVICE_ROLE_KEY in VITE_* vars
